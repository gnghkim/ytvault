# ytvault health check: judges the app's state and pushes it to Uptime Kuma.
# Started every minute by ytvault-healthcheck.timer. Replace <user> with the
# account that runs ytvault.service, then copy to /etc/systemd/system/.
# See docs/HEALTH_MONITORING.md.

[Unit]
Description=ytvault health check (push to Uptime Kuma)
Documentation=https://github.com/gnghkim/ytvault/blob/master/docs/HEALTH_MONITORING.md
# Deliberately no Requires=/BindsTo=ytvault.service: the check must still run
# (and report down) when ytvault itself is stopped.
After=network-online.target ytvault.service

[Service]
Type=oneshot
User=<user>
WorkingDirectory=/home/<user>/ytvault
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/<user>/ytvault/.venv/bin/python healthcheck.py
# One run is a few file reads, a read-only SQLite query and two local HTTP
# requests. Cap it so a hang never piles up runs or competes with downloads.
TimeoutStartSec=45
Nice=10
CPUQuota=20%
MemoryMax=128M

# Least privilege: the check only reads files and talks to localhost.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Uptime Kuma and the web UI are both on this machine. Remove these two lines
# if YTVAULT_KUMA_PUSH_URL points to another host.
IPAddressDeny=any
IPAddressAllow=localhost
