# 자세한 설명은 SETUP.md 참고. 경로는 프로젝트 폴더 기준.

# 텔레그램 (필수). 허용 chat ID를 비우면 누구나 봇을 쓸 수 있다
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321

# Google Drive. 폴더 ID를 비우면 내 드라이브 최상위에 저장
GDRIVE_FOLDER_ID=your_google_drive_folder_id
GDRIVE_CLIENT_SECRET_PATH=client_secret.json
GDRIVE_TOKEN_PATH=token.json

# Gemini 요약 (선택). 비우면 요약 없이 저장
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Notion 기록 (선택). 비우면 건너뜀
NOTION_TOKEN=
NOTION_DATABASE_ID=

DOWNLOAD_DIR=downloads
DB_PATH=ytvault.db

WEB_HOST=0.0.0.0
WEB_PORT=8000
# Web UI login (HTTP Basic). Leave WEB_PASSWORD empty and the UI stays closed.
WEB_USERNAME=ytvault
WEB_PASSWORD=
